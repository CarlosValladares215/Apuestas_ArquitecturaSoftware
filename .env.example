# ==============================================================================
# Variables de entorno de ejemplo (NO colocar secretos reales aquí)
# Copia este archivo a .env para desarrollo local.
# ==============================================================================

NODE_ENV=development

# --- Infraestructura local (Docker Compose) ---
POSTGRES_USER=apuestas_dev
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=apuestas_db
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Backend API (apps/api - NestJS) ---
API_PORT=3001
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://apuestas_dev:changeme_local_only@localhost:5432/apuestas_db
REDIS_URL=redis://localhost:6379

# --- Autenticación y seguridad (usados desde Spec 002) ---
JWT_ACCESS_SECRET=replace_with_min_32_char_random_secret
JWT_REFRESH_SECRET=replace_with_min_32_char_random_secret

# --- Integraciones externas (SOLO backend, nunca en apps/web) ---
API_FOOTBALL_KEY=replace_with_api_football_sandbox_key
PAYPHONE_TOKEN=replace_with_payphone_sandbox_token
PAYPHONE_STORE_ID=replace_with_payphone_store_id

# --- Servicio de reportes (apps/reports - Python solo lectura) ---
REPORTS_PORT=8000
REPORTS_DATABASE_URL=postgresql://apuestas_readonly:changeme_readonly_local@localhost:5432/apuestas_db
REPORTS_CORS_ORIGIN=http://localhost:3000

# --- Frontend Web (apps/web - Next.js, solo URLs públicas) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_REPORTS_URL=http://localhost:8000
